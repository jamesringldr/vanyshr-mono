# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Local UI preview (optional): open any route without auth/workflow.
# Vite `pnpm dev` already bypasses auth. Set this only for local `vite preview`.
# Never enable on Vercel production.
# VITE_ALLOW_ROUTE_BYPASS=true

# Geoapify (zip code lookup)
VITE_GEOAPIFY_API_KEY=

# Zabasearch Relay Worker (legacy / optional)
# Base URL of the deployed Cloudflare Worker (no trailing slash).
# Deploy: cd workers/zabasearch-relay && wrangler deploy
VITE_ZABA_RELAY_URL=https://zabasearch-relay.vanyshrrelay.workers.dev

# Residential Zaba service on serv01 (same pattern as FPS — not via edge).
# Requires network path to the box (Tailscale). Leave unset in public prod
# until a public tunnel/hostname is provisioned.
# VITE_ZABA_SERVICE_URL=http://serv-01.tail7e9bab.ts.net:8788
# VITE_ZABA_SERVICE_TOKEN=
